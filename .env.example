# the legal gate, and fixture specialists — enough for tests and dry-runs.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Local checkout of https://github.com/DUROV-OS/vault_backups (private).
VAULT_ROOT=

# Optional live connectors. Empty = fixture / vault-only mode.
AMOCRM_MCP_URL=
MOYSKLAD_MCP_URL=
MAIL_MCP_URL=
VAULT_MCP_URL=
